###############################################################################
#  PrimeChat — .gitignore
#  Security-first. When in doubt, exclude it.
###############################################################################


# ─────────────────────────────────────────────────────────────────────────────
#  SECRETS & CREDENTIALS  (NEVER commit these)
# ─────────────────────────────────────────────────────────────────────────────

# Environment files — contain DB creds, VAPID keys, API tokens
.env
.env.*
!.env.example        # safe to commit a sanitised template

# PHP config files — these read from .env, safe to track
# config/database.php  ← tracks env-var loading, no hardcoded secrets
# config/app.php       ← only app constants (name, paths, limits)
# config/session.php   ← only session cookie settings
# .env file is the real secret — keep it ignored

# Certificate / key material
*.pem
*.key
*.crt
*.cer
*.cert
*.p12
*.pfx
*.jks

# Push notification keys
vapid_keys.json
vapid_private.key

# OAuth / API secrets
*.secret
*_secret.json
google-credentials.json
firebase-credentials.json
service-account*.json


# ─────────────────────────────────────────────────────────────────────────────
#  SESSION DATA  (live auth tokens — catastrophic if leaked)
# ─────────────────────────────────────────────────────────────────────────────

session_cookie.txt
session_cookie*.txt
*.session
sessions/
/tmp/sessions/


# ─────────────────────────────────────────────────────────────────────────────
#  DATABASE DUMPS & BACKUPS  (contain all user PII)
# ─────────────────────────────────────────────────────────────────────────────

*.sql
*.sqlite
*.sqlite3
*.db
backups/
/tmp/db_*

# Keep schema migrations — they're safe
!sql/schema.sql
!sql/migrations/


# ─────────────────────────────────────────────────────────────────────────────
#  LOGS  (may contain PII, IP addresses, stack traces)
# ─────────────────────────────────────────────────────────────────────────────

logs/
*.log
*.log.*
log/
/tmp/*.log
send_debug.log


# ─────────────────────────────────────────────────────────────────────────────
#  USER-GENERATED CONTENT  (private files, avatars, attachments)
# ─────────────────────────────────────────────────────────────────────────────

public/uploads/
public/avatars/
storage/


# ─────────────────────────────────────────────────────────────────────────────
#  PHP / COMPOSER
# ─────────────────────────────────────────────────────────────────────────────

vendor/
composer.phar
.phpunit.result.cache
.phpunit.cache/
coverage/
.php_cs.cache
.php-cs-fixer.cache


# ─────────────────────────────────────────────────────────────────────────────
#  NODE / NPM
# ─────────────────────────────────────────────────────────────────────────────

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-debug.log*
.yarn/


# ─────────────────────────────────────────────────────────────────────────────
#  WEBSOCKET SERVER
# ─────────────────────────────────────────────────────────────────────────────

ws/*.pid
ws/*.sock
ws/server.log


# ─────────────────────────────────────────────────────────────────────────────
#  BUILD ARTIFACTS
# ─────────────────────────────────────────────────────────────────────────────

# Keep compiled CSS (so deployment doesn't need build step)
# public/css/app.css   ← intentionally tracked

dist/
build/
.cache/
.parcel-cache/


# ─────────────────────────────────────────────────────────────────────────────
#  IDE & EDITOR
# ─────────────────────────────────────────────────────────────────────────────

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.sublime-project
.sublime-workspace


# ─────────────────────────────────────────────────────────────────────────────
#  OS JUNK
# ─────────────────────────────────────────────────────────────────────────────

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ─────────────────────────────────────────────────────────────────────────────
#  TEMPORARY & MISC
# ─────────────────────────────────────────────────────────────────────────────

/tmp/
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
~$*

# Analysis / report files generated by tooling (not source code)
PROJECT_ANALYSIS.txt
PROJECT_ANALYSIS.md
PROMPT_ENGINEER_REPORT.txt
graphify-out/

# PHP session directory
/var/lib/php/sessions/

# Apache / server config (site-specific, not portable)
primechat.conf
*.conf
!nginx.conf.example
!apache.conf.example